# Скопируйте в .env.local (локально) или в Vercel → Settings → Environment Variables

# Адрес сайта (для sitemap, OG-картинок и фида Авито)
NEXT_PUBLIC_SITE_URL=https://myagko.vercel.app

# Заказы в Telegram (можно вместе с MAX; без каналов заказ пишется в лог сервера)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Склад в Google Таблице (см. stock/README.md); без них остатки — из products.json
STOCK_API_URL=
STOCK_API_KEY=

# Заказы в MAX (dev.max.ru). Бот — у @MasterBot. ID узнать: npm run max:setup
# Укажите MAX_CHAT_ID (групповой чат, бот — админ) ИЛИ MAX_USER_ID (личные сообщения)
MAX_BOT_TOKEN=
MAX_CHAT_ID=
MAX_USER_ID=
